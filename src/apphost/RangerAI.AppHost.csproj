<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>rangerai-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep these in step with the Aspire CLI version in .devcontainer/scripts/postcreate.sh: since Aspire 17,
         the dashboard and DCP come from the installed CLI. -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
  </ItemGroup>

  <!-- .NET projects are added by path in AppHost.cs (AddDotnetProject); they need no ProjectReference here. -->

</Project>
