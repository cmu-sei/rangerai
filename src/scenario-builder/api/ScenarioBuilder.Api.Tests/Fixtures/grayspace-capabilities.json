 "roles": [
  {
   "name": "ad-dc",
   "description": "A Samba Active Directory domain controller for the site",
   "os_families": [
    "ubuntu",
    "debian"
   ],
   "variables": {
    "realm": {
     "description": "The Kerberos realm / DNS domain of the directory, e.g. corp.meridian-bank.com",
     "required": true,
     "default": null
    },
    "domain": {
     "description": "The NetBIOS domain name, e.g. MERIDIAN",
     "required": true,
     "default": null
    },
    "admin_password": {
     "description": "Password of the domain Administrator",
     "required": true,
     "default": null
    }
   }
  },
  {
   "name": "dns",
   "description": "BIND as a site DNS server, authoritative for an internal zone and forwarding everything else to the base resolver",
   "os_families": [
    "ubuntu",
    "debian"
   ],
   "variables": {
    "zone": {
     "description": "The internal zone (default <prefix>.internal); every host of the site gets an A record in it",
     "required": false,
     "default": null
    }
   }
  },
  {
   "name": "file",
   "description": "A Samba file share",
   "os_families": [
    "ubuntu",
    "debian"
   ],
   "variables": {
    "share_name": {
     "description": "Name of the share",
     "required": false,
     "default": "shared"
    },
    "guest_ok": {
     "description": "Allow guest access",
     "required": false,
     "default": true
    }
   }
  },
  {
   "name": "ghosts-client",
   "description": "A GHOSTS client (Universal on Linux, the Windows client on Windows), installed from client_url and configured to report to api_url under a hostname-based identity. GraySpace ships no GHOSTS binaries.",
   "os_families": [
    "ubuntu",
    "debian",
    "windows"
   ],
   "variables": {
    "client_url": {
     "description": "URL of the client release archive (.tar.gz or .zip) the host downloads over the management network",
     "required": true,
     "default": null
    },
    "api_url": {
     "description": "The GHOSTS API root, e.g. http://ghosts-api:5000/api",
     "required": true,
     "default": null
    },
    "api_host": {
     "description": "An address that must stay reachable over the management network (the GHOSTS API, v1 \u00a79 option A); a host route is added for it",
     "required": false,
     "default": null
    },
    "executable": {
     "description": "The client program inside the archive (default Ghosts.Client.Universal, or Ghosts.Client.Windows.exe on Windows)",
     "required": false,
     "default": null
    },
    "timeline": {
     "description": "A GHOSTS timeline (JSON object) to write as config/timeline.json",
     "required": false,
     "default": null
    }
   }
  },
  {
   "name": "mail",
   "description": "Postfix and Dovecot (SMTP and IMAP) for a slice domain, with local mailboxes",
   "os_families": [
    "ubuntu",
    "debian"
   ],
   "variables": {
    "domain": {
     "description": "The mail domain (default the first DNS domain of the slice)",
     "required": false,
     "default": null
    },
    "users": {
     "description": "Mailboxes to create: a list of {name, password}",
     "required": false,
     "default": []
    }
   }
  },
  {
   "name": "web",
   "description": "nginx serving a placeholder site; HTTPS too when the slice issues the host a certificate",
   "os_families": [
    "ubuntu",
    "debian"
   ],
   "variables": {
    "site_title": {
     "description": "Title of the placeholder page (default the host's name)",
     "required": false,
     "default": null
    }
   }
  }
 ],
