    {
      "kind": "summary",
      "id": "summary",
      "visibility": "excon",
      "title": "Executive summary",
      "text": "Ransomware reaches Bayport's cargo scheduling through a phished assistant. Leaders must decide when to escalate, with the harbor master away.",
      "standing": "stated"
    },
    {
      "kind": "objective",
      "id": "obj-escalate",
      "visibility": "participant",
      "text": "Leaders decide when to escalate to the national CERT.",
      "measures": [
        "Escalation decided within 30 minutes of the ransom note."
      ],
      "standing": "stated"
    },
    {
      "kind": "teachingPoint",
      "id": "tp-plan",
      "visibility": "participant",
      "text": "An incident response plan only works if people know who owns each decision.",
      "objectiveIds": [
        "obj-escalate"
      ],
      "standing": "stated"
    },
    {
      "kind": "rule",
      "id": "rule-scope",
      "visibility": "participant",
      "text": "Ransom payment is in scope for discussion.",
      "category": "scope",
      "standing": "stated"
    },
    {
      "kind": "term",
      "id": "term-cert",
      "visibility": "participant",
      "text": "national CERT",
      "usage": "fixed",
      "standing": "stated"
    },
    {
      "kind": "plannedEvent",
      "id": "pe-phish",
      "visibility": "excon",
      "title": "Phishing email",
      "offset": "00:10:00",
      "objectiveIds": [
        "obj-escalate"
      ],
      "inject": {
        "channel": "email",
        "from": "harbor-master",
        "to": [
          "office-staff"
        ],
        "content": "Updated berth schedule attached."
      },
      "cyber": {
        "class": "PhishingAttack",
        "actorIds": [
          "red"
        ],
        "targetIds": [
          "mail"
        ],
        "mitreTechniqueIds": [
          "T1566.001"
        ]
      },
      "expectedResponse": "Nobody notices yet.",
      "standing": "stated"
    },
    {
      "kind": "plannedEvent",
      "id": "pe-news",
      "visibility": "excon",
      "title": "Local news picks it up",
      "offset": "00:45:00",
      "after": [
        "pe-phish"
      ],
      "influence": {
        "action": "post",
        "actorId": "office-staff",
        "serviceId": "harbor-talk",
        "text": "Anyone else's email down at the port?"
      },
      "escalations": [
        "If nobody reacts, a reporter calls the communications lead."
      ],
      "standing": "stated"
